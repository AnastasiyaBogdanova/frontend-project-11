{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "unicorn"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-console": "off"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
